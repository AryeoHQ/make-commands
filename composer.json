{
    "name": "aryeo/make-commands",
    "description": "A package to add domain aware make commands to Laravel applications.",
    "keywords": [
        "Aryeo",
        "laravel",
        "eloquent"
    ],
    "homepage": "https://github.com/aryeohq/make-commands",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Fonseca",
            "email": "robfo@zillowgroup.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "aryeo/attribute-routing": "^0.0.4",
        "aryeo/eloquent-filters": "^0.0.1",
        "laravel/framework": "^12.0",
        "laravel/prompts": "^0.3.8",
        "symfony/console": "^7.3"
    },
    "require-dev": {
        "aryeo/tooling-laravel": "^0.0.1",
        "brianium/paratest": "^7.0",
        "nikic/php-parser": "^5.7",
        "orchestra/testbench": "^10.0.0",
        "orchestra/testbench-core": "^10.0.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.3"
    },
    "repositories": {
        "tooling-laravel": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/tooling-laravel"
        },
        "attribute-routing": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/attribute-routing"
        },
        "eloquent-filters": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/eloquent-filters"
        }
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support/",
            "Tooling\\": "src/Tooling/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aryeo/tooling-laravel": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Providers\\MakeCommandsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
